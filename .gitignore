# Konfiguration mit Zugangsdaten – nie im Repository
app/config.local.php
.env

# Laufzeitdaten
storage/uploads/*
!storage/uploads/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/sessions/*
storage/sla.lock
!storage/sessions/.gitkeep

# Abhaengigkeiten (falls Composer genutzt wird)
vendor/

*.log
.DS_Store
Thumbs.db

# Film: Quelle liegt im Git, die Ausgabe nicht (zu gross und jederzeit neu erzeugbar)
video/*.mp4
video/roh/
video/film-lokal.html
video/ton*/
video/node_modules/
video/package*.json
video/__pycache__/

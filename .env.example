# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Öffentliche Adresse des Frontends – wird für Links in Mails und im
# Kundenportal verwendet.
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Unbedingt in Produktion ersetzen (z. B. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-me-in-production
SESSION_DAYS=7

# ─── Daten ────────────────────────────────────────────────────────────────
DB_FILE=./data/crm.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ─── Reaktionszeit ────────────────────────────────────────────────────────
# Standardziel bis zur ersten Kontaktaufnahme. Pro Fachgruppe im CRM
# (Team & Routing) übersteuerbar.
SLA_MINUTES=15

# ─── E-Mail ───────────────────────────────────────────────────────────────
# Ohne SMTP_HOST werden Mails nur protokolliert und sind im CRM unter
# "Postausgang" einsehbar – die App läuft also auch ohne Mailserver.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="21 Capital Invest <no-reply@example.com>"

# ─── Firmendaten (Mailfuß, Kundenportal) ──────────────────────────────────
COMPANY_NAME=21 Capital Invest
COMPANY_PHONE=+49 40 000 000
COMPANY_EMAIL=service@example.com

# ─── KI-Angebotsentwurf (optional) ────────────────────────────────────────
# Ohne Schlüssel erzeugt die App einen strukturierten Textbaustein.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

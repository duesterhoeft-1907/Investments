# ─────────────────────────────────────────────────────────────────────────
#  Capital Lead Suite – Apache-Regeln (SiteGround)
# ─────────────────────────────────────────────────────────────────────────

# Verzeichnisse nicht auflisten
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Vorhandene Dateien (CSS, JS, Bilder) direkt ausliefern …
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # … alles andere geht an den Front-Controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Mikrofon wird für Sprachnotizen gebraucht, alles andere bleibt zu.
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(self)"
</IfModule>

# Zwischenspeichern – aber nur, was gefahrlos alt sein darf.
#
# Schriften und Bilder duerfen lange liegen: ihre Namen aendern sich, wenn
# sich ihr Inhalt aendert. CSS und JS nicht: die Einstiegsdateien tragen
# zwar einen Zeitstempel, die davon geladenen Module aber nicht. Mit einer
# Woche Ruhe saehe der Browser nach jedem Ausrollen weiter den alten Stand –
# und der Fehler saehe aus, als waere gar nichts angekommen.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 30 days"
    ExpiresByType image/png              "access plus 30 days"
    ExpiresByType image/webp             "access plus 30 days"
    ExpiresByType image/jpeg             "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    # Kurz halten und immer nachfragen. Der Server antwortet dann meist mit
    # "unveraendert" – das kostet fast nichts und kann nie veralten.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(woff2|png|webp|jpe?g|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Der Typ, mit dem JavaScript ausgeliefert wird.
#
# Ein Browser lehnt ein Modul ab, wenn der Server es nicht als JavaScript
# ausweist – und zwar wortlos: die Seite bleibt leer, in der Konsole steht
# etwas von "Expected a JavaScript module script". Auf dem eigenen Rechner
# faellt das nie auf, weil der eingebaute Server es richtig macht. Also
# sagen wir es hier selbst, statt uns auf die Voreinstellung zu verlassen.
<IfModule mod_mime.c>
    AddType text/javascript              .js .mjs
    AddType text/css                     .css
    AddType application/json             .json
    AddType image/webp                   .webp
    AddType image/svg+xml                .svg
    AddType font/woff2                   .woff2
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Punktdateien nie ausliefern
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
